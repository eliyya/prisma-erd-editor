{
    "name": "prisma-erd-editor",
    "version": "0.2.2",
    "description": "Prisma generator for ERD Editor compatible .erd diagrams",
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "main": "./dist/api.js",
    "types": "./dist/api.d.ts",
    "exports": {
        ".": {
            "types": "./dist/api.d.ts",
            "import": "./dist/api.js"
        }
    },
    "bin": {
        "prisma-erd-editor": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "test": "pnpm run build && vp test run",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "check": "vp check",
        "verify": "pnpm run build && vp check && vp test run",
        "prepublishOnly": "pnpm run verify"
    },
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliyya/prisma-erd-editor.git"
    },
    "bugs": {
        "url": "https://github.com/eliyya/prisma-erd-editor/issues"
    },
    "homepage": "https://github.com/eliyya/prisma-erd-editor#readme",
    "devDependencies": {
        "@types/node": "26.6.6",
        "ajv": "8.20.0",
        "prisma": "7.10.1",
        "typescript": "7.0.2",
        "vite-plus": "1.5.0"
    },
    "dependencies": {
        "@eliyya/flagged-bitfield": "1.1.1",
        "@prisma/generator-helper": "7.10.1"
    },
    "engines": {
        "node": ">=20.19"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.0",
            "onFail": "download"
        }
    }
}
